    \expDetail{Message Broker: RabbitMQ, Kafka}
    \expDetail{Security: Keycloak, Spring Security, OAuth 2.0 Resource Server, Nimbus JOSE JWT (JWE encryption, JWS integrity verification)}
  \end{itemize}

  \expSubHeader{Responsibilities:}
