% Convenience shorthands
\newcommand{\detailsize}{\fontsize{12}{14}\selectfont}
\newcommand{\subheadsize}{\fontsize{12}{14}\selectfont}

%-------------------------
% Custom commands
\newcommand{\resumeItem}[2]{
  \item\detailsize{
    \textbf{#1}{: #2 \vspace{-2pt}}
  }
}

\newcommand{\resumeItemWithoutTitle}[1]{
  \item\detailsize{
    {\vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-1pt}\item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textbf{\detailsize #1} & \detailsize #2 \\
      \textit{\detailsize #3} & \textit{\detailsize #4} \\
    \end{tabular*}\vspace{-5pt}
}

% Company heading: left = company+role (bold), right = date
\newcommand{\expHeading}[2]{%
  \vspace{2pt}
  \begin{tabular*}{\textwidth}{l@{\extracolsep{\fill}}r}
    \textbf{\detailsize #1} & \detailsize #2 \\
  \end{tabular*}\vspace{0pt}
}

% Project sub-heading (bold+italic for "Project", rest italic)
\newcommand{\projectHeading}[1]{%
  \vspace{1pt}
  \hspace{12pt}\textbf{\detailsize Project}{\detailsize #1}
  \vspace{1pt}
}

\newcommand{\resumeSubItem}[2]{\resumeItem{#1}{#2}\vspace{-3pt}}

\renewcommand{\labelitemii}{$\circ$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=*]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

% Black-circle sub-header item (Description / Technologies / Responsibilities)
\newcommand{\expSubHeader}[1]{%
  \item[\textbullet] \detailsize\textbf{#1}%
}

% White-circle detail item
\newcommand{\expDetail}[1]{%
  \item[$\circ$] \detailsize #1%
}

