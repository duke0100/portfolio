    \expDetail{Designed and implemented backend workflows for core features, including search, audit logging, and security-related services}
    \expDetail{Maintained and optimized backend systems and database performance, identifying and resolving bottlenecks}
    \expDetail{Defined and built reusable feature skeletons and coding patterns to support maintainability, scalability, and consistent development across services}
    \expDetail{Developed and extended a plugin-based architecture for system components, enabling flexible integration and future extensions}
  \end{itemize}
\end{itemize}

